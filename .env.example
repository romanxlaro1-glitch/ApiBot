# Copy to .env and fill in. Never commit the real .env.
#
# /api/v1/ai/ask falls back to these when chatbotchatapp.com reports
# dailyChatLimitOfGuest for the direct IP. Format: user@host:port, comma
# separated. Paid pools are the reliable option; see the "Open proxies"
# section of the README for the free list, which is opt-in and unreliable.
ASK_PROXIES=mob-id@gw.proxyrise.com:443,mob-id@gw.proxyrise.com:443,mob-sg@gw.proxyrise.com:443
ASK_PROXY_PASSWORD=your-proxy-password

# Seconds one proxied attempt may take before it is given up on.
ASK_PROXY_TIMEOUT=60

# Optional. Path to a JSON list of "host:port" open proxies. Only used by
# /api/v1/ai/ask, only after the direct attempt failed, and only for the
# pollinations upstream, whose anonymous window is per exit IP. Roughly 0.1%
# of advertised free proxies complete a real request, so treat this as a
# short-lived cache. Leave unset to disable the fallback entirely.
# ASK_FREE_PROXIES=/root/ApiBot/free_proxies.json
